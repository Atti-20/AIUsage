<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background_app"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:text="> AI USAGE"
        android:textColor="@color/widget_app_text"
        android:textSize="12sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/claude_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="62dp"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="Claude"
            android:textColor="@color/widget_app_claude"
            android:textSize="11sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/claude_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="5dp"
            android:layout_weight="1"
            android:progressBackgroundTint="@color/widget_app_track"
            android:progressTint="@color/widget_app_claude" />

        <TextView
            android:id="@+id/claude_percent"
            android:layout_width="46dp"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:gravity="end"
            android:textColor="@color/widget_app_text"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/claude_reset"
            android:layout_width="70dp"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:gravity="end"
            android:textColor="@color/widget_app_muted"
            android:textSize="9sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/codex_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="62dp"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="Codex"
            android:textColor="@color/widget_app_signal"
            android:textSize="11sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/codex_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="5dp"
            android:layout_weight="1"
            android:progressBackgroundTint="@color/widget_app_track"
            android:progressTint="@color/widget_app_signal" />

        <TextView
            android:id="@+id/codex_percent"
            android:layout_width="46dp"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:gravity="end"
            android:textColor="@color/widget_app_text"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/codex_reset"
            android:layout_width="70dp"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:gravity="end"
            android:textColor="@color/widget_app_muted"
            android:textSize="9sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/project_ranking"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="> PROJECT RANK"
            android:textColor="@color/widget_app_muted"
            android:textSize="9sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/project_row_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/project_name_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:text="#1 Project"
                android:textColor="@color/widget_app_text"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/project_cost_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="$0.00"
                android:textColor="@color/widget_app_muted"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/project_row_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/project_name_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:text="#2 Project"
                android:textColor="@color/widget_app_text"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/project_cost_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="$0.00"
                android:textColor="@color/widget_app_muted"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/empty_state"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fontFamily="monospace"
        android:gravity="center"
        android:textColor="@color/widget_app_muted"
        android:textSize="11sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/today_cost"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:textColor="@color/widget_app_text"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/month_cost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="@color/widget_app_muted"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
